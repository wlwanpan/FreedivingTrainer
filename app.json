{
  "expo": {
    "name": "Freediving & CO2 Tables",
    "slug": "FreedivingTrainer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "freedivingtrainer",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/AppIcon.icon",
      "bundleIdentifier": "com.wlwanpan.FreedivingTrainer",
      "appleTeamId": "WD73B9M86L",
      "supportsTablet": false,
      "userInterfaceStyle": "light",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
            "backgroundColor": "#F4F9F9"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.5"
          },
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F4F9F9"
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-localization",
      [
        "@bacons/apple-targets",
        {
          "appleTeamId": "WD73B9M86L"
        }
      ],
      "./plugins/withWatchEasParent",
      "./plugins/withPbxprojObjectVersion"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "appVariant": "production",
      "revenueCatIosApiKey": "",
      "revenueCatAndroidApiKey": "",
      "eas": {
        "projectId": "3686bd0e-4427-42da-bdb2-b762b007e855"
      }
    },
    "owner": "wlwanpan.dev"
  }
}
