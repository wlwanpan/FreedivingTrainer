{
  "cli": {
    "version": ">= 16.19.3",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "image": "latest"
      },
      "env": {
        "APP_VARIANT": "development",
        "EXPO_APPLE_TEAM_ID": "WD73B9M86L"
      }
    },
    "ios-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_APPLE_TEAM_ID": "WD73B9M86L"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "APP_VARIANT": "production",
        "EXPO_APPLE_TEAM_ID": "WD73B9M86L"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "bundleIdentifier": "com.wlwanpan.FreedivingTrainer",
        "ascAppId": "6821739312",
        "appleTeamId": "WD73B9M86L"
      }
    }
  }
}
