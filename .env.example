# Copy this file to .env. Expo loads .env, not .env.example.
# Do not commit secrets.

APP_VARIANT=development

# RevenueCat public SDK keys. Create a FreedivingTrainer project in RevenueCat.
# iOS: appl_...   Android: goog_...
REVENUECAT_IOS_API_KEY=test_EUhdAZilOHgMXlhNEztwCdNeDFQ
REVENUECAT_ANDROID_API_KEY=test_EUhdAZilOHgMXlhNEztwCdNeDFQ

# Numeric App Store Connect Apple ID (App Information → Apple ID).
# Set this on the EAS production environment for the iOS deploy workflow:
# eas env:set --name ASC_APP_ID --value <apple-id> --environment production --visibility sensitive
ASC_APP_ID=
